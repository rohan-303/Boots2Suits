{
  "name": "@boots2suits/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @boots2suits/db",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build --workspace @boots2suits/db",
    "start": "node dist/index.js",
    "prelint": "npm run build --workspace @boots2suits/db",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretypecheck": "npm run build --workspace @boots2suits/db",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@boots2suits/db": "0.1.0",
    "@types/multer": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
